# --- Supabase ---
# Récupérées dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...votre_cle_anon...

# --- Fonctionnalités optionnelles ---
# Mettre "true" pour activer la vue administrateur (stats agrégées du groupe).
# Nécessite aussi profiles.is_admin = true pour l'utilisateur concerné,
# et d'avoir exécuté la migration supabase/migrations/0002_admin.sql.
NEXT_PUBLIC_ENABLE_ADMIN=false
